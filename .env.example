# Copy to .env for local development. Never commit the real file.

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTARR_SECRET_KEY=
# Generate: openssl rand -base64 48
MASTARR_JWT_SECRET=

MASTARR_DATA_DIR=./data
MASTARR_LOG_LEVEL=INFO

# Hosts the discovery scan probes when the UI form is left empty.
# MASTARR_DISCOVERY_HOSTS=["192.168.1.250"]

